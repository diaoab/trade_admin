# Adresse de l'API trade_back, utilisée par le proxy du serveur de dev
# (le navigateur appelle /api, Vite relaie vers <cible>/trade/v1).
VITE_API_PROXY_TARGET=http://localhost:8000

# En production (build statique), URL publique de l'API, préfixe /trade/v1 compris
# (ex. https://api.exemple.com/trade/v1). Laisser vide pour conserver /api derrière
# Nginx, qui relaie vers l'API.
VITE_API_URL=
